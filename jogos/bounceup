function tryEnterFullscreenNow() {
  try {
    const el = document.documentElement;
    if (document.fullscreenElement || !el.requestFullscreen || !gIsMobileLike()) return;
    el.requestFullscreen().catch(() => {});
  } catch (e) {}
}
tryEnterFullscreenNow();
gSetupFullscreenOnFirstInteraction();

(async function boot() {
  user = await gRequireSession();
  if (!user) return;
  resize();
  resetGame();
  draw();
  refreshBest();
})();
</script>
