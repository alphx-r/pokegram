<style>
  *{-webkit-tap-highlight-color:transparent;box-sizing:border-box}
  *{
    -webkit-user-select:none;-moz-user-select:none;-ms-user-select:none;user-select:none;
    -webkit-touch-callout:none;
  }
  html,body{
    margin:0;height:100%;height:100dvh;width:100%;font-family:'Nunito',sans-serif;background:#f4f4f4;color:#1a1a1a;
    overflow:hidden;position:fixed;inset:0;
    display:flex;flex-direction:column;
  }
  :root{
    --brand:#4a2e7a;--brand-mid:#7c4fc9;--accent:#f2c94c;--border:#e0e0e0;--muted:#6b7280;--stone:#c9a86a;
  }
  .ap-nav{
    display:flex;align-items:center;justify-content:space-between;
    padding:0 16px;height:52px;flex:0 0 52px;background:var(--brand);
    box-shadow:0 2px 8px rgba(0,0,0,.15);position:relative;z-index:20;
  }
  .ap-back{display:flex;align-items:center;gap:6px;color:#fff;text-decoration:none;font-weight:700;font-size:13px}
  .ap-back svg{width:18px;height:18px;stroke:#fff;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}
  .ap-title{font-family:'Cinzel',serif;font-size:15px;color:#fff}
  .ap-title span{color:var(--accent)}

  .ap-wrap{
    flex:1 1 auto;min-height:0;position:relative;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    touch-action:none;overflow:hidden;
    background:radial-gradient(ellipse at 50% 20%, #2f2050 0%, #150e29 70%);
  }

  .ap-hud{
    position:absolute;top:0;left:0;right:0;z-index:20;margin-top:12px;
    display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none;
  }
  .ap-hud-box{
    display:flex;gap:clamp(14px,5vw,26px);align-items:center;justify-content:center;
    background:rgba(255,255,255,.9);border-radius:10px;
    padding:9px clamp(18px,5vw,26px);box-shadow:0 2px 8px rgba(0,0,0,.3);
    pointer-events:auto;
  }
  .ap-hud-item{
    flex:0 1 auto;white-space:nowrap;text-align:center;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  }
  .ap-hud-label{font-size:clamp(7px,2.2vw,9px);font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;line-height:1}
  .ap-hud-value{font-family:'Cinzel',serif;font-size:clamp(13px,4vw,17px);color:var(--brand);font-weight:700;white-space:nowrap;line-height:1}

  .ap-board-outer{
    position:relative;
    display:grid;
    grid-template-columns:34px auto 34px;
    grid-template-rows:34px auto 34px;
    gap:6px;
    transform-origin:center center;
  }
  .ap-board{
    grid-column:2;grid-row:2;
    position:relative;overflow:hidden;border-radius:6px;
    box-shadow:0 0 0 3px var(--stone), 0 10px 30px rgba(0,0,0,.5);
    background:#000;
  }
  .ap-tile{
    position:absolute;top:0;left:0;
    background-repeat:no-repeat;
    transition:transform .18s cubic-bezier(.4,0,.2,1);
    box-shadow:inset 0 0 0 1px rgba(0,0,0,.25);
  }
  .ap-arrow{
    border:none;border-radius:8px;cursor:pointer;
    background:linear-gradient(160deg, var(--stone), #a3823f);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 3px 8px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.3);
    transition:transform .1s ease;
    touch-action:manipulation;
  }
  .ap-arrow:active{transform:scale(.88);background:linear-gradient(160deg, #a3823f, var(--stone))}
  .ap-arrow svg{width:16px;height:16px;stroke:#2f2010;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
  .ap-arrow-row{grid-column:2;display:flex;justify-content:space-around}
  .ap-arrow-row.ap-top{grid-row:1}
  .ap-arrow-row.ap-bottom{grid-row:3}
  .ap-arrow-col{grid-row:2;display:flex;flex-direction:column;justify-content:space-around}
  .ap-arrow-col.ap-left{grid-column:1}
  .ap-arrow-col.ap-right{grid-column:3}
  .ap-arrow-cell{width:34px;height:34px}

  .ap-ref-box{
    position:absolute;bottom:calc(14px + env(safe-area-inset-bottom,0px));right:14px;z-index:15;
    width:56px;height:56px;border-radius:10px;overflow:hidden;
    border:2px solid rgba(255,255,255,.4);box-shadow:0 4px 12px rgba(0,0,0,.4);
    background-size:cover;background-position:center;
    opacity:.85;transition:width .2s ease, height .2s ease;
  }
  .ap-ref-box.ap-ref-big{width:140px;height:140px}
  .ap-ref-label{
    position:absolute;bottom:calc(74px + env(safe-area-inset-bottom,0px));right:14px;z-index:15;
    font-size:9px;font-weight:800;color:rgba(255,255,255,.6);text-transform:uppercase;letter-spacing:.4px;
  }

  .ap-hint{
    position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    z-index:100;pointer-events:auto;
    background:rgba(10,10,20,0.8);
    opacity:1;transition:opacity .35s ease;
  }
  .ap-hint.hide{opacity:0;pointer-events:none}
  .ap-hint-card{
    background:rgba(30,20,50,0.92);
    border:1.5px solid rgba(255,255,255,0.12);
    border-radius:16px;
    padding:20px 22px;
    max-width:280px;
    text-align:center;
    box-shadow:0 8px 30px rgba(0,0,0,.4);
    pointer-events:auto;
  }
  .ap-hint-title{
    font-family:'Cinzel',serif;color:var(--accent);font-size:15px;font-weight:700;
    margin:0 0 12px;
  }
  .ap-hint-row{
    display:flex;align-items:center;gap:10px;
    margin-bottom:10px;text-align:left;
  }
  .ap-hint-row:last-of-type{margin-bottom:0}
  .ap-hint-icon{
    width:30px;height:30px;flex:none;border-radius:8px;
    background:rgba(255,255,255,0.08);
    display:flex;align-items:center;justify-content:center;
    font-size:15px;
  }
  .ap-hint-text{font-size:12px;color:#fff;line-height:1.35}
  .ap-hint-text b{color:var(--accent)}
  .ap-hint-dismiss{
    margin-top:14px;font-size:11px;color:rgba(255,255,255,0.55);
    font-weight:700;text-transform:uppercase;letter-spacing:.4px;
  }

  .ap-overlay{
    position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;
    align-items:center;justify-content:center;z-index:300;
  }
  .ap-overlay.show{display:flex}
  .ap-modal{
    background:#fff;border-radius:14px;padding:26px 24px;max-width:320px;width:88%;text-align:center;
    max-height:86vh;overflow:auto;
  }
  .ap-modal h2{font-family:'Cinzel',serif;color:var(--brand);margin:0 0 6px;font-size:20px}
  .ap-modal p{color:var(--muted);font-size:13px;margin:0 0 14px}
  .ap-solved-img{width:120px;height:120px;border-radius:10px;object-fit:cover;margin:0 auto 14px;display:block;box-shadow:0 4px 14px rgba(0,0,0,.25)}
  .ap-final-score{font-family:'Cinzel',serif;font-size:36px;color:var(--brand-mid);margin-bottom:2px}
  .ap-stats-line{font-size:12.5px;color:var(--muted);margin-bottom:6px}
  .ap-best-line{font-size:12.5px;color:var(--muted);margin-bottom:18px}
  .ap-best-line b{color:var(--brand)}
  .ap-panel-title{font-size:10px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin:0 0 8px;text-align:left}
  .ap-lb-box{text-align:left;margin-bottom:18px}
  .ap-lb-row{display:flex;align-items:center;gap:6px;padding:3px 0;font-size:12.5px}
  .ap-lb-pos{width:16px;font-weight:800;color:var(--brand-mid)}
  .ap-lb-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .ap-lb-score{font-weight:800}
  .ap-lb-empty{font-size:11.5px;color:var(--muted);font-style:italic}
  .ap-btn{
    padding:11px 22px;border:none;border-radius:8px;background:var(--brand-mid);color:#fff;
    font-family:'Nunito',sans-serif;font-weight:800;font-size:14px;cursor:pointer;width:100%;
  }
  .ap-btn:hover{background:var(--brand)}
  #ap-share-btn{background:#f2a33c;margin-top:8px}
  #ap-share-btn:hover{background:#d98a1f}
</style>
