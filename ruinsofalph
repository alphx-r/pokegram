<script src="/games-common.js"></script>
<script>
// ════════════════════════════════════════════════════════
// Ruínas de Alph — puzzle de deslizar linha/coluna (cíclico,
// sem espaço vazio), igual às câmaras de imagem do jogo
// original. Chave de leaderboard: 'ruinasdealph'.
//
// IMPORTANTE (rodar antes de usar em produção):
// se a tabela `game_scores` tiver uma CHECK constraint restringindo
// os valores aceitos pra coluna `game` (ex.: enum de 'tetris',
// 'flapidgey', 'voltorbolha'), é preciso adicionar 'ruinasdealph'
// nela, senão gSaveScore vai falhar silenciosamente (cai na fila de
// pendentes em localStorage e nunca é aceito).
// ════════════════════════════════════════════════════════

const N = 4; // tamanho do grid (4x4 — mesmo tamanho das câmaras de imagem originais)
const BOARD_SIZE = 320; // tamanho lógico do tabuleiro em px (antes da escala responsiva)
const CELL = BOARD_SIZE / N;

// Imagens do puzzle: por padrão usa só o Ditto (via PokeAPI), mas pode
// ser sobrescrito/expandido salvando uma lista separada por vírgula na
// tabela `settings` (mesmo padrão do tyrunt_sprite_normal etc.):
//   insert into settings (key, value) values
//     ('ruinasdealph_images', 'https://url1.png,https://url2.png')
//   on conflict (key) do update set value = excluded.value;
// A cada partida nova, uma imagem da lista é escolhida aleatoriamente.
// Requisito: a imagem deve ser QUADRADA (mesma largura e altura) pra
// as peças ficarem com o recorte correto.
const PUZZLE_IMAGES_DEFAULT = [
  'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/132.png',
];
let PUZZLE_IMAGES = [...PUZZLE_IMAGES_DEFAULT];

async function loadPuzzleImages() {
  try {
    const { data, error } = await gdb.from('settings').select('value').eq('key', 'ruinasdealph_images').maybeSingle();
    if (error) { console.warn('[loadPuzzleImages] erro ao buscar imagens', error); return; }
    if (data && data.value) {
      const list = data.value.split(',').map(s => s.trim()).filter(Boolean);
      if (list.length) PUZZLE_IMAGES = list;
    }
  } catch (e) { console.warn('[loadPuzzleImages]', e); }
}

let currentImage = PUZZLE_IMAGES_DEFAULT[0];
let user, best = 0;
let moves = 0;
let startTime = null;
let elapsedMs = 0;
let timerHandle = null;
let solved = false;
let scale = 1;

// pos[tileId] = {row, col} — posição ATUAL da peça no tabuleiro.
// A peça `tileId` pertence, por definição, à posição "casa"
// row = floor(tileId / N), col = tileId % N — é essa posição de
// origem que decide qual pedaço da imagem aparece nela (a peça em si
// nunca muda de recorte, só de posição no tabuleiro).
let pos = [];
let tileEls = [];

const boardOuter = document.getElementById('ap-board-outer');
const movesEl = document.getElementById('ap-moves');
const timeEl = document.getElementById('ap-time');
const bestEl = document.getElementById('ap-best');
const refBox = document.getElementById('ap-ref-box');

function homeRowCol(id) { return { row: Math.floor(id / N), col: id % N }; }

function buildBoardDom() {
  boardOuter.innerHTML = '';

  // setas de cima (empurram coluna pra CIMA)
  const topRow = document.createElement('div');
  topRow.className = 'ap-arrow-row ap-top';
  for (let c = 0; c < N; c++) topRow.appendChild(makeArrowBtn('up', () => shiftCol(c, -1)));
  boardOuter.appendChild(topRow);

  // setas da esquerda (empurram linha pra ESQUERDA)
  const leftCol = document.createElement('div');
  leftCol.className = 'ap-arrow-col ap-left';
  for (let r = 0; r < N; r++) leftCol.appendChild(makeArrowBtn('left', () => shiftRow(r, -1)));
  boardOuter.appendChild(leftCol);

  // tabuleiro
  const board = document.createElement('div');
  board.className = 'ap-board';
  board.id = 'ap-board';
  board.style.width = BOARD_SIZE + 'px';
  board.style.height = BOARD_SIZE + 'px';
  boardOuter.appendChild(board);

  // setas da direita (empurram linha pra DIREITA)
  const rightCol = document.createElement('div');
  rightCol.className = 'ap-arrow-col ap-right';
  for (let r = 0; r < N; r++) rightCol.appendChild(makeArrowBtn('right', () => shiftRow(r, 1)));
  boardOuter.appendChild(rightCol);

  // setas de baixo (empurram coluna pra BAIXO)
  const bottomRow = document.createElement('div');
  bottomRow.className = 'ap-arrow-row ap-bottom';
  for (let c = 0; c < N; c++) bottomRow.appendChild(makeArrowBtn('down', () => shiftCol(c, 1)));
  boardOuter.appendChild(bottomRow);

  tileEls = [];
  for (let id = 0; id < N * N; id++) {
    const { row, col } = homeRowCol(id);
    const el = document.createElement('div');
    el.className = 'ap-tile';
    el.style.width = CELL + 'px';
    el.style.height = CELL + 'px';
    el.style.backgroundImage = `url("${currentImage}")`;
    el.style.backgroundSize = `${BOARD_SIZE}px ${BOARD_SIZE}px`;
    el.style.backgroundPosition = `-${col * CELL}px -${row * CELL}px`;
    board.appendChild(el);
    tileEls[id] = el;
  }
}

const ARROW_ICON = {
  up: '<polyline points="18 15 12 9 6 15"/>',
  down: '<polyline points="6 9 12 15 18 9"/>',
  left: '<polyline points="15 18 9 12 15 6"/>',
  right: '<polyline points="9 18 15 12 9 6"/>',
};
function makeArrowBtn(dir, onClick) {
  const btn = document.createElement('button');
  btn.className = 'ap-arrow ap-arrow-cell';
  btn.innerHTML = `<svg viewBox="0 0 24 24">${ARROW_ICON[dir]}</svg>`;
  btn.addEventListener('click', () => { if (!solved) onClick(); });
  return btn;
}

function render() {
  for (let id = 0; id < N * N; id++) {
    const { row, col } = pos[id];
    tileEls[id].style.transform = `translate(${col * CELL}px, ${row * CELL}px)`;
  }
}

// Lê a linha `r` (peças em cada coluna, na ordem 0..N-1) ou a coluna `c`
// (peças em cada linha, na ordem 0..N-1) — a mesma função de rotação
// cíclica serve pra ambos os casos.
function getRowTiles(r) {
  const arr = new Array(N);
  for (let id = 0; id < N * N; id++) if (pos[id].row === r) arr[pos[id].col] = id;
  return arr;
}
function getColTiles(c) {
  const arr = new Array(N);
  for (let id = 0; id < N * N; id++) if (pos[id].col === c) arr[pos[id].row] = id;
  return arr;
}
function rotateCyclic(arr, dir) {
  // dir -1 = desloca "pra trás" (índice 0 vai pro fim); dir +1 = desloca "pra frente" (fim vai pro início)
  return dir < 0 ? arr.slice(1).concat(arr[0]) : [arr[arr.length - 1], ...arr.slice(0, arr.length - 1)];
}

function shiftRow(r, dir, silent) {
  const shifted = rotateCyclic(getRowTiles(r), dir);
  shifted.forEach((id, col) => { pos[id].col = col; });
  if (!silent) afterMove();
}
function shiftCol(c, dir, silent) {
  const shifted = rotateCyclic(getColTiles(c), dir);
  shifted.forEach((id, row) => { pos[id].row = row; });
  if (!silent) afterMove();
}

function afterMove() {
  moves++;
  movesEl.textContent = moves;
  render();
  if (checkSolved()) onSolved();
}

function checkSolved() {
  for (let id = 0; id < N * N; id++) {
    const h = homeRowCol(id);
    if (pos[id].row !== h.row || pos[id].col !== h.col) return false;
  }
  return true;
}

function shuffleBoard() {
  pos = [];
  for (let id = 0; id < N * N; id++) pos[id] = homeRowCol(id);
  // Só linhas/colunas cíclicas são usadas pra embaralhar, então o
  // estado embaralhado É, por construção, sempre resolvível (basta
  // desfazer os mesmos movimentos na ordem inversa).
  const SHUFFLE_STEPS = 60;
  for (let i = 0; i < SHUFFLE_STEPS; i++) {
    const useRow = Math.random() < 0.5;
    const idx = Math.floor(Math.random() * N);
    const dir = Math.random() < 0.5 ? -1 : 1;
    if (useRow) shiftRow(idx, dir, true); else shiftCol(idx, dir, true);
  }
  if (checkSolved()) shuffleBoard(); // (extremamente raro, mas por garantia)
  render();
}

function formatTime(ms) {
  const s = Math.floor(ms / 1000);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
}

function startTimer() {
  startTime = Date.now();
  elapsedMs = 0;
  timeEl.textContent = '0:00';
  clearInterval(timerHandle);
  timerHandle = setInterval(() => {
    elapsedMs = Date.now() - startTime;
    timeEl.textContent = formatTime(elapsedMs);
  }, 500);
}
function stopTimer() {
  clearInterval(timerHandle);
  elapsedMs = Date.now() - startTime;
  timeEl.textContent = formatTime(elapsedMs);
}

// Pontuação: começa em 3000 e perde 12 pontos por movimento e 3 por
// segundo gasto, nunca fica negativa. É só uma fórmula inicial — dá
// pra ajustar os pesos livremente sem quebrar nada mais (o leaderboard
// só entende "maior é melhor").
function computeScore() {
  const secs = Math.floor(elapsedMs / 1000);
  return Math.max(0, 3000 - moves * 12 - secs * 3);
}

let finalScore = 0;
function onSolved() {
  solved = true;
  stopTimer();
  finalScore = computeScore();
  document.getElementById('ap-final-score').textContent = finalScore;
  document.getElementById('ap-stats-line').textContent = `${moves} movimentos · ${formatTime(elapsedMs)}`;
  document.getElementById('ap-solved-img').src = currentImage;
  document.getElementById('ap-overlay').classList.add('show');
  if (user) gSaveScore('ruinasdealph', finalScore, user).then(refreshBest);
  refreshLeaderboard();
}

function newGame() {
  solved = false;
  moves = 0;
  movesEl.textContent = '0';
  document.getElementById('ap-overlay').classList.remove('show');
  currentImage = PUZZLE_IMAGES[Math.floor(Math.random() * PUZZLE_IMAGES.length)];
  refBox.style.backgroundImage = `url("${currentImage}")`;
  buildBoardDom();
  shuffleBoard();
  startTimer();
}
document.getElementById('ap-restart-btn').addEventListener('click', newGame);

// ── Referência ampliável (toque pra crescer/encolher) ────
refBox.addEventListener('click', () => refBox.classList.toggle('ap-ref-big'));

// ── Responsivo: escala o tabuleiro+setas pra caber na tela ─
function resize() {
  const wrap = document.getElementById('ap-wrap');
  const availW = wrap.clientWidth - 24;
  const availH = wrap.clientHeight - 24;
  const natural = BOARD_SIZE + 2 * 40; // tabuleiro + setas dos dois lados
  scale = Math.min(1, availW / natural, availH / natural);
  boardOuter.style.transform = `scale(${scale})`;
}
window.addEventListener('resize', resize);
window.addEventListener('orientationchange', () => setTimeout(resize, 150));
document.addEventListener('fullscreenchange', () => setTimeout(resize, 150));
if (window.visualViewport) window.visualViewport.addEventListener('resize', resize);

// ── Ranking ───────────────────────────────────────────────
async function refreshLeaderboard() {
  const el = document.getElementById('ap-leaderboard');
  const top = await gLoadTopScores('ruinasdealph', 5);
  if (top.length === 0) {
    el.innerHTML = '<div class="ap-lb-empty">Nenhum recorde ainda.</div>';
    return;
  }
  el.innerHTML = top.map((row, i) => `
    <div class="ap-lb-row">
      <span class="ap-lb-pos">${i + 1}º</span>
      <span class="ap-lb-name">${gEsc(row.author_name || '???')}</span>
      <span class="ap-lb-score">${row.score}</span>
    </div>`).join('');
}

async function refreshBest() {
  if (!user) return;
  best = await gLoadMyBest('ruinasdealph', user.id);
  bestEl.textContent = best || '–';
  document.getElementById('ap-best-line-val').textContent = best || '–';
}

// ── Compartilhar resultado no Stories ──────────────────────
function buildResultCanvas() {
  const W = 1080, H = 1920;
  const c = document.createElement('canvas');
  c.width = W; c.height = H;
  const c2 = c.getContext('2d');

  const bg = c2.createLinearGradient(0, 0, 0, H);
  bg.addColorStop(0, '#2f2050');
  bg.addColorStop(1, '#150e29');
  c2.fillStyle = bg;
  c2.fillRect(0, 0, W, H);

  c2.textAlign = 'center';
  c2.fillStyle = '#f2c94c';
  c2.font = "800 64px 'Cinzel', serif";
  c2.fillText('Ruínas de Alph', W / 2, 300);

  return new Promise((resolve) => {
    const img = new Image();
    img.crossOrigin = 'anonymous';
    const finish = () => {
      const size = 500, x = W / 2 - size / 2, y = 420;
      c2.save();
      c2.strokeStyle = '#c9a86a';
      c2.lineWidth = 8;
      c2.strokeRect(x - 4, y - 4, size + 8, size + 8);
      try { c2.drawImage(img, x, y, size, size); } catch (e) { /* imagem não carregou a tempo — segue sem ela */ }
      c2.restore();

      c2.fillStyle = 'rgba(255,255,255,.9)';
      const cardW = 760, cardH = 300, cardX = (W - cardW) / 2, cardY = y + size + 60;
      c2.beginPath();
      c2.roundRect ? c2.roundRect(cardX, cardY, cardW, cardH, 28) : c2.rect(cardX, cardY, cardW, cardH);
      c2.fill();

      c2.fillStyle = '#6b7280';
      c2.font = "800 32px 'Nunito', sans-serif";
      c2.fillText('PONTOS', W / 2, cardY + 66);

      c2.fillStyle = '#4a2e7a';
      c2.font = "800 120px 'Cinzel', serif";
      c2.fillText(String(finalScore), W / 2, cardY + 190);

      c2.fillStyle = '#7c4fc9';
      c2.font = "700 34px 'Nunito', sans-serif";
      c2.fillText(`${moves} movimentos · ${formatTime(elapsedMs)}`, W / 2, cardY + 250);

      c2.fillStyle = '#fff';
      c2.font = "800 50px 'Nunito', sans-serif";
      c2.shadowColor = 'rgba(0,0,0,.35)';
      c2.shadowBlur = 10;
      c2.shadowOffsetY = 2;
      const ctaLines = wrapCanvasText(c2, `Eu resolvi o enigma de Alph, venha jogar também!`, W - 140);
      let ctaY = cardY + cardH + 90;
      ctaLines.forEach(line => { c2.fillText(line, W / 2, ctaY); ctaY += 64; });
      c2.shadowColor = 'transparent';
      c2.shadowBlur = 0;
      c2.shadowOffsetY = 0;

      resolve(c);
    };
    img.onload = finish;
    img.onerror = finish;
    img.src = currentImage;
  });
}

function wrapCanvasText(ctx2d, text, maxWidth) {
  const words = text.split(' ');
  const lines = [];
  let current = '';
  words.forEach(word => {
    const test = current ? `${current} ${word}` : word;
    if (ctx2d.measureText(test).width > maxWidth && current) {
      lines.push(current);
      current = word;
    } else {
      current = test;
    }
  });
  if (current) lines.push(current);
  return lines;
}

async function shareResultToStories() {
  let dataUrl = null;
  try {
    const canvas = await buildResultCanvas();
    dataUrl = canvas.toDataURL('image/png');
  } catch (e) {
    console.warn('[shareResultToStories] falhou ao gerar imagem do resultado', e);
  }
  if (dataUrl) {
    try {
      sessionStorage.setItem('pg_pending_story_image', JSON.stringify({
        image: dataUrl,
        gameLink: '/ruinasdealph.html'
      }));
    } catch (e) {
      console.warn('[shareResultToStories] falhou ao guardar imagem no sessionStorage', e);
    }
  }
  window.location.href = '/';
}
document.getElementById('ap-share-btn').addEventListener('click', shareResultToStories);

