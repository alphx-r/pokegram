{
  "rewrites": [
    { "source": "/jogos", "destination": "/jogos.html" },
    { "source": "/jogos/", "destination": "/jogos.html" },
    { "source": "/jogos/bounceup", "destination": "/jogos/bounceup.html" },
    { "source": "/jogos/bounceup/", "destination": "/jogos/bounceup.html" },
    { "source": "/jogos/flapidgey", "destination": "/flapidgey.html" },
    { "source": "/jogos/flapidgey/", "destination": "/flapidgey.html" },
    { "source": "/jogos/tetris", "destination": "/tetris.html" },
    { "source": "/jogos/tetris/", "destination": "/tetris.html" },
    { "source": "/jogos/tyrunt", "destination": "/tyrunt.html" },
    { "source": "/jogos/tyrunt/", "destination": "/tyrunt.html" },
    { "source": "/jogos/voltorbolha", "destination": "/voltorbolha.html" },
    { "source": "/jogos/voltorbolha/", "destination": "/voltorbolha.html" },
    { "source": "/jogos/pokebubbles", "destination": "/pokebubbles.html" },
    { "source": "/jogos/pokebubbles/", "destination": "/pokebubbles.html" },
    { "source": "/jogos/whackadiglett", "destination": "/whackadiglett.html" },
    { "source": "/jogos/whackadiglett/", "destination": "/whackadiglett.html" },
    { "source": "/((?!icons/|manifest\\.webmanifest|sw\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
